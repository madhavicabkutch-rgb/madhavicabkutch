{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "madhavicabkutch",
	"main": "src/worker.js",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	// D1 Database Binding
	// To enable, create the database in Cloudflare dashboard or via 'npx wrangler d1 create madhavicab-db'
	// and paste the real UUID into database_id below:
	// "d1_databases": [
	//   {
	//     "binding": "DB",
	//     "database_name": "madhavicab-db",
	//     "database_id": "<PASTE_REAL_D1_UUID_HERE>"
	//   }
	// ],
	"vars": {
		"SITE_URL": "https://madhavicabkutch.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "madhavicab-db",
			"database_id": "f9dc4d74-c6a3-4f3c-90c0-ff9255d8cc07",
			"remote": true
		}
	]
}